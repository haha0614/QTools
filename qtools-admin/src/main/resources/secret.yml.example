# ============================================================
# 本地私密配置模板
#   用法：把本文件复制为同目录下的 secret.yml，填入真实值。
#   secret.yml 已被 .gitignore 排除，不会被提交。
#   项目通过 application.yml 的 spring.config.import 可选加载它；文件缺失时自动跳过，
#   但缺少数据库密码 / token.secret / qtools.app.jwt.secret 会导致启动失败
#   （这是预期的快速失败，避免误用默认密钥）。
#   部署到服务器时建议改用环境变量或密钥管理服务，而不是上传该文件。
# ============================================================

spring:
  datasource:
    druid:
      master:
        # 数据库密码；可用环境变量 SPRING_DATASOURCE_DRUID_MASTER_PASSWORD 覆盖
        password: 你的数据库密码
  data:
    redis:
      # 便携 Redis 默认无密码，留空即可
      password:

# 若依后台（/login、sys_user）的 JWT 签名密钥；可用环境变量 TOKEN_SECRET 覆盖
token:
  # 随机生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
  secret: 请填入 64 位随机十六进制

# 用户端（/api/app/**）独立 JWT 密钥
# 必须与上面的 token.secret 不同；缺失或相同会导致启动失败
qtools:
  app:
    jwt:
      secret: 请填入另一串随机字符串

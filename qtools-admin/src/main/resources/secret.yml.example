# ============================================================
# 本地私密配置模板
#   用法：把本文件复制为同目录下的 application-secret.yml，填入真实值。
#   application-secret.yml 已被 .gitignore 排除，不会被提交。
#   项目通过 application.yml 的 spring.config.import 可选加载它；文件缺失时自动跳过，
#   但缺少数据库密码 / token.secret 会导致启动失败（这是预期的快速失败，避免误用默认密钥）。
#   部署到服务器时建议改用环境变量，而不是上传该文件：
#     SPRING_DATASOURCE_DRUID_MASTER_PASSWORD   数据库密码
#     TOKEN_SECRET                              JWT 签名密钥
# ============================================================

spring:
  datasource:
    druid:
      master:
        password: 你的数据库密码
      statViewServlet:
        # Druid 监控台口令（/druid/*）；生产环境建议关闭 statViewServlet 或限制来源 IP
        login-password: 你的Druid控制台密码

token:
  # JWT 密钥，随机生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
  secret: 请填入随机字符串

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>qtools</artifactId>
        <groupId>com.qtools</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>qtools-media</artifactId>

    <description>
        media媒体站模块（只读接口：索引/视频/相册/文件Range/缩略图/字幕/实时转码）
    </description>

    <dependencies>

        <!-- 通用工具（已传递提供 spring-web、validation、mybatis、jackson 等依赖） -->
        <dependency>
            <groupId>com.qtools</groupId>
            <artifactId>qtools-common</artifactId>
        </dependency>

        <!--
            单测（P6.02 起）：本模块原来没有测试源码，自动分级的规则引擎/模型回复解析是纯函数，
            最值得单测。版本由 spring-boot-dependencies 统一管理，不写 version。
            scope=test：不进运行时依赖，部署包不受影响。
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                surefire 3.x 才认 JUnit 5（Maven 自带的老版本会「0 tests run」地静默通过）。
                只在本模块声明，不动父 pom 的其它模块。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

</project>
